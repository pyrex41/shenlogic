; ShenLogic typed evaluation graph v2
(value-signature (constructors (constructor int int 1) (constructor true true 0) (constructor false false 0) (constructor symbol symbol 1) (constructor string string 1) (constructor nil nil 0) (constructor cons cons 2)))
(relation even-v2? (value) value)
(relation odd-v2? (value) value)
