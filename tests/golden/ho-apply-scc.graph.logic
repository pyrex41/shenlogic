; ShenLogic typed evaluation graph v2
(value-signature (constructors (constructor int int 1) (constructor true true 0) (constructor false false 0) (constructor symbol symbol 1) (constructor string string 1) (constructor nil nil 0) (constructor cons cons 2)))
(relation inc (value) value)
(relation id-app (value) value)
(relation sl.apply-1 (value value) value)
(rule inc_c0_p0 (function inc) (clause 0) (path 0)
  (args ((v-var inc_a0)))
  (bound ((v-var inc_a0) (i-var inc_a0)))
  (when (value-eq (v-var inc_a0) (v-int (i-var inc_a0))))
  (derive (inc (v-var inc_a0) (v-int (i-add (i-var inc_a0) (i-lit 1)))))
)
(rule id-app_c0_p0 (function id-app) (clause 0) (path 0)
  (args ((v-var id-app_a0)))
  (bound ((v-var id-app_a0) (v-var R0)))
  (when (call sl.apply-1 ((v-var id-app_a0) (v-int (i-lit 0))) (v-var R0)))
  (derive (id-app (v-var id-app_a0) (v-var R0)))
)
(rule sl.apply-1_inc (function sl.apply-1) (clause 0) (path 0)
  (args ((v-symbol inc) (v-var sl.apply-1_a0)))
  (bound ((v-var sl.apply-1_a0) (v-var sl.apply-1_r)))
  (when (call inc ((v-var sl.apply-1_a0)) (v-var sl.apply-1_r)))
  (derive (sl.apply-1 (v-symbol inc) (v-var sl.apply-1_a0) (v-var sl.apply-1_r)))
)
(rule sl.apply-1_id-app (function sl.apply-1) (clause 1) (path 0)
  (args ((v-symbol id-app) (v-var sl.apply-1_a0)))
  (bound ((v-var sl.apply-1_a0) (v-var sl.apply-1_r)))
  (when (call id-app ((v-var sl.apply-1_a0)) (v-var sl.apply-1_r)))
  (derive (sl.apply-1 (v-symbol id-app) (v-var sl.apply-1_a0) (v-var sl.apply-1_r)))
)
(least-scc (inc))
(least-scc (sl.apply-1 id-app))
(name-map ((inc inc) (id-app id-app) (sl.apply-1 sl.apply-1)))
