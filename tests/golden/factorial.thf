thf(sl_ctor_cons_injective,axiom,(! [V_X0:value,V_X1:value,V_Y0:value,V_Y1:value] : (((sl_ctor_cons @ V_X0 @ V_X1) = (sl_ctor_cons @ V_Y0 @ V_Y1)) => ((V_X0 = V_Y0) & (V_X1 = V_Y1))))).
