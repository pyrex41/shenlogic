thf(sl_value_induction,axiom,(! [P:(value > $o)] : ((((! [V_A0:$int] : (P @ (sl_ctor_int @ V_A0))) & ((P @ sl_ctor_true) & ((P @ sl_ctor_false) & ((! [V_A0:$i] : (P @ (sl_ctor_symbol @ V_A0))) & ((! [V_A0:$i] : (P @ (sl_ctor_string @ V_A0))) & ((P @ sl_ctor_nil) & ((! [V_A0:value,V_A1:value] : (((P @ V_A0) & (P @ V_A1)) => (P @ (sl_ctor_cons @ V_A0 @ V_A1)))) & $true)))))))) => (! [X:value] : (P @ X))))).
thf(sl_rule_factorial_underc0_underp0,axiom,(! [V_factorial_undera0:value] : (((V_factorial_undera0 = (sl_ctor_int @ 0)) => (sl_rel_factorial @ V_factorial_undera0 @ (sl_ctor_int @ 1)))))).
thf(sl_rule_factorial_underc1_underp1,axiom,(! [V_factorial_undera0:value,I_factorial_undera0:$int,V_R0:value,I_R0:$int] : ((((V_factorial_undera0 != (sl_ctor_int @ 0)) & ((V_factorial_undera0 = (sl_ctor_int @ I_factorial_undera0)) & ((sl_rel_factorial @ (sl_ctor_int @ $difference(I_factorial_undera0,1)) @ V_R0) & ((V_factorial_undera0 = (sl_ctor_int @ I_factorial_undera0)) & (V_R0 = (sl_ctor_int @ I_R0)))))) => (sl_rel_factorial @ V_factorial_undera0 @ (sl_ctor_int @ $product(I_factorial_undera0,I_R0))))))).
thf(sl_least_factorial,axiom,(! [R_factorial:(value > value > $o)] : ((((! [V_factorial_undera0:value] : (((V_factorial_undera0 = (sl_ctor_int @ 0)) => (R_factorial @ V_factorial_undera0 @ (sl_ctor_int @ 1))))) & (! [V_factorial_undera0:value,I_factorial_undera0:$int,V_R0:value,I_R0:$int] : ((((V_factorial_undera0 != (sl_ctor_int @ 0)) & ((V_factorial_undera0 = (sl_ctor_int @ I_factorial_undera0)) & ((R_factorial @ (sl_ctor_int @ $difference(I_factorial_undera0,1)) @ V_R0) & ((V_factorial_undera0 = (sl_ctor_int @ I_factorial_undera0)) & (V_R0 = (sl_ctor_int @ I_R0)))))) => (R_factorial @ V_factorial_undera0 @ (sl_ctor_int @ $product(I_factorial_undera0,I_R0))))))) => (! [V_A0:value,V_Result:value] : (((sl_rel_factorial @ V_A0 @ V_Result) => (R_factorial @ V_A0 @ V_Result)))))))).
