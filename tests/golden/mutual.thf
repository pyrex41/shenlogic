thf(sl_value_induction,axiom,(! [P:(value > $o)] : ((((! [V_A0:$int] : (P @ (sl_ctor_int @ V_A0))) & ((P @ sl_ctor_true) & ((P @ sl_ctor_false) & ((! [V_A0:$i] : (P @ (sl_ctor_symbol @ V_A0))) & ((! [V_A0:$i] : (P @ (sl_ctor_string @ V_A0))) & ((P @ sl_ctor_nil) & ((! [V_A0:value,V_A1:value] : (((P @ V_A0) & (P @ V_A1)) => (P @ (sl_ctor_cons @ V_A0 @ V_A1)))) & $true)))))))) => (! [X:value] : (P @ X))))).
thf(sl_rule_even_q_underc0_underp0,axiom,(! [V_even_q_undera0:value] : (((V_even_q_undera0 = (sl_ctor_int @ 0)) => (sl_rel_even_q @ V_even_q_undera0 @ sl_ctor_true))))).
thf(sl_rule_even_q_underc1_underp1,axiom,(! [V_even_q_undera0:value,I_even_q_undera0:$int,V_R0:value] : ((((V_even_q_undera0 != (sl_ctor_int @ 0)) & ((V_even_q_undera0 = (sl_ctor_int @ I_even_q_undera0)) & (sl_rel_odd_q @ (sl_ctor_int @ $difference(I_even_q_undera0,1)) @ V_R0))) => (sl_rel_even_q @ V_even_q_undera0 @ V_R0))))).
thf(sl_rule_odd_q_underc0_underp0,axiom,(! [V_odd_q_undera0:value] : (((V_odd_q_undera0 = (sl_ctor_int @ 0)) => (sl_rel_odd_q @ V_odd_q_undera0 @ sl_ctor_false))))).
