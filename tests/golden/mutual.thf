thf(sl_least_odd_q_even_q,axiom,(! [R_odd_q:(value > value > $o),R_even_q:(value > value > $o)] : ((((! [V_even_q_undera0:value] : (((V_even_q_undera0 = (sl_ctor_int @ 0)) => (R_even_q @ V_even_q_undera0 @ sl_ctor_true)))) & ((! [V_even_q_undera0:value,I_even_q_undera0:$int,V_R0:value] : ((((V_even_q_undera0 != (sl_ctor_int @ 0)) & ((V_even_q_undera0 = (sl_ctor_int @ I_even_q_undera0)) & (R_odd_q @ (sl_ctor_int @ $difference(I_even_q_undera0,1)) @ V_R0))) => (R_even_q @ V_even_q_undera0 @ V_R0)))) & ((! [V_odd_q_undera0:value] : (((V_odd_q_undera0 = (sl_ctor_int @ 0)) => (R_odd_q @ V_odd_q_undera0 @ sl_ctor_false)))) & (! [V_odd_q_undera0:value,I_odd_q_undera0:$int,V_R0:value] : ((((V_odd_q_undera0 != (sl_ctor_int @ 0)) & ((V_odd_q_undera0 = (sl_ctor_int @ I_odd_q_undera0)) & (R_even_q @ (sl_ctor_int @ $difference(I_odd_q_undera0,1)) @ V_R0))) => (R_odd_q @ V_odd_q_undera0 @ V_R0))))))) => ((! [V_A0:value,V_Result:value] : (((sl_rel_odd_q @ V_A0 @ V_Result) => (R_odd_q @ V_A0 @ V_Result)))) & (! [V_A0:value,V_Result:value] : (((sl_rel_even_q @ V_A0 @ V_Result) => (R_even_q @ V_A0 @ V_Result))))))))).
