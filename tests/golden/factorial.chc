; Horn fixedpoint rules over boxed Value; ALL required by Z3 String/datatype combination
(set-logic ALL)
(declare-datatypes () ((Value (VInt (VInt_value Int)) VTrue VFalse (VSymbol (VSymbol_value String)) (VString (VString_value String)) VNil (VCons (VCons_head Value) (VCons_tail Value)))))
(declare-rel factorial (Value Value))
(declare-var sl_v_factorial_a0 Value)
(declare-var sl_i_factorial_a0 Int)
(declare-var sl_v_R0 Value)
(declare-var sl_i_R0 Int)
(rule (=> (= sl_v_factorial_a0 (VInt 0)) (factorial sl_v_factorial_a0 (VInt 1))))
(rule (=> (and (not (= sl_v_factorial_a0 (VInt 0))) (= sl_v_factorial_a0 (VInt sl_i_factorial_a0)) (factorial (VInt (- sl_i_factorial_a0 1)) sl_v_R0) (= sl_v_factorial_a0 (VInt sl_i_factorial_a0)) (= sl_v_R0 (VInt sl_i_R0))) (factorial sl_v_factorial_a0 (VInt (* sl_i_factorial_a0 sl_i_R0)))))
