; Horn fixedpoint rules over boxed Value; ALL required by Z3 String/datatype combination
(set-logic ALL)
(declare-datatypes () ((Value (VInt (VInt_value Int)) VTrue VFalse (VSymbol (VSymbol_value String)) (VString (VString_value String)) VNil (VCons (VCons_head Value) (VCons_tail Value)))))
(declare-rel double (Value Value))
(declare-rel positive_q (Value Value))
(declare-rel map (Value Value Value))
(declare-rel filter (Value Value Value))
(declare-rel twice (Value Value Value))
(declare-rel sl_apply_1 (Value Value Value))
(declare-var sl_v_double_a0 Value)
(declare-var sl_i_double_a0 Int)
(declare-var sl_v_positive_q_a0 Value)
(declare-var sl_i_positive_q_a0 Int)
(declare-var sl_v_map_a0 Value)
(declare-var sl_v_map_a1 Value)
(declare-var sl_v_M1 Value)
(declare-var sl_v_M0 Value)
(declare-var sl_v_R0 Value)
(declare-var sl_v_R1 Value)
(declare-var sl_v_filter_a0 Value)
(declare-var sl_v_filter_a1 Value)
(declare-var sl_v_twice_a0 Value)
(declare-var sl_v_twice_a1 Value)
(declare-var sl_v_sl_apply_1_a0 Value)
(declare-var sl_v_sl_apply_1_r Value)
(rule (=> (= sl_v_double_a0 (VInt sl_i_double_a0)) (double sl_v_double_a0 (VInt (* 2 sl_i_double_a0)))))
(rule (=> (and (= sl_v_positive_q_a0 (VInt sl_i_positive_q_a0)) (> sl_i_positive_q_a0 0)) (positive_q sl_v_positive_q_a0 VTrue)))
(rule (=> (and (= sl_v_positive_q_a0 (VInt sl_i_positive_q_a0)) (<= sl_i_positive_q_a0 0)) (positive_q sl_v_positive_q_a0 VFalse)))
(rule (=> (and ((_ is VNil) sl_v_map_a1) true) (map sl_v_map_a0 sl_v_map_a1 VNil)))
(rule (=> (and (not ((_ is VNil) sl_v_map_a1)) (and ((_ is VCons) sl_v_map_a1) (and (= (VCons_head sl_v_map_a1) sl_v_M1) (= (VCons_tail sl_v_map_a1) sl_v_M0))) (sl_apply_1 sl_v_map_a0 sl_v_M1 sl_v_R0) (map sl_v_map_a0 sl_v_M0 sl_v_R1)) (map sl_v_map_a0 sl_v_map_a1 (VCons sl_v_R0 sl_v_R1))))
(rule (=> (and ((_ is VNil) sl_v_filter_a1) true) (filter sl_v_filter_a0 sl_v_filter_a1 VNil)))
(rule (=> (and (not ((_ is VNil) sl_v_filter_a1)) (and ((_ is VCons) sl_v_filter_a1) (and (= (VCons_head sl_v_filter_a1) sl_v_M1) (= (VCons_tail sl_v_filter_a1) sl_v_M0))) (sl_apply_1 sl_v_filter_a0 sl_v_M1 sl_v_R0) (= sl_v_R0 VTrue) (filter sl_v_filter_a0 sl_v_M0 sl_v_R1)) (filter sl_v_filter_a0 sl_v_filter_a1 (VCons sl_v_M1 sl_v_R1))))
(rule (=> (and (not ((_ is VNil) sl_v_filter_a1)) (and ((_ is VCons) sl_v_filter_a1) (and (= (VCons_head sl_v_filter_a1) sl_v_M1) (= (VCons_tail sl_v_filter_a1) sl_v_M0))) (sl_apply_1 sl_v_filter_a0 sl_v_M1 sl_v_R0) (not (= sl_v_R0 VTrue)) (filter sl_v_filter_a0 sl_v_M0 sl_v_R1)) (filter sl_v_filter_a0 sl_v_filter_a1 sl_v_R1)))
(rule (=> (and (sl_apply_1 sl_v_twice_a0 sl_v_twice_a1 sl_v_R0) (sl_apply_1 sl_v_twice_a0 sl_v_R0 sl_v_R1)) (twice sl_v_twice_a0 sl_v_twice_a1 sl_v_R1)))
(rule (=> (double sl_v_sl_apply_1_a0 sl_v_sl_apply_1_r) (sl_apply_1 (VSymbol "double") sl_v_sl_apply_1_a0 sl_v_sl_apply_1_r)))
(rule (=> (positive_q sl_v_sl_apply_1_a0 sl_v_sl_apply_1_r) (sl_apply_1 (VSymbol "positive?") sl_v_sl_apply_1_a0 sl_v_sl_apply_1_r)))
