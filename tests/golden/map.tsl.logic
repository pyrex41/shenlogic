; ShenLogic tsl v1
; deduction system: docs/TSL-LOGIC.md
; totality: double total (non-recursive)
; totality: positive? total (non-recursive)
; totality: map unknown (depends on function-parameter)
; totality: filter unknown (depends on function-parameter)
; totality: twice unknown (depends on function-parameter)

; list axioms
(all A : type (all X : A (all Y : (list A) (all Z : A (all W : (list A) (((cons X Y) = (cons Z W)) => (and (X = Z) (Y = W))))))))
(all A : type (all X : A (all Y : (list A) (~ ((cons X Y) = ())))))
(all A : type (all P : ((list A) => o) ((and (P ()) (all X : A (all Y : (list A) ((P Y) => (P (cons X Y)))))) => (all L : (list A) (P L)))))
; boolean axioms
(~ (true = false))
(all B : boolean (or (B = true) (B = false)))
; boolean bridge axioms
(all X : number (all Y : number ((> X Y) => ((> X Y) = true))))
(all X : number (all Y : number ((~ (> X Y)) => ((> X Y) = false))))
; conditional axioms
(all A : type (all X : A (all Y : A ((if true X Y) = X))))
(all A : type (all X : A (all Y : A ((if false X Y) = Y))))

; definedness: function application
(all X0 : number (defined-apply-1 double X0))
(all X0 : number (defined-apply-1 positive? X0))
; definedness: map
(all A : type (all B : type (all F : (A --> B) (defined-map F ()))))
(all A : type (all B : type (all F : (A --> B) (all X : A (all Y : (list A) ((and (defined-apply-1 F X) (defined-map F Y)) => (defined-map F (cons X Y))))))))
(all A : type (all B : type (all F : (A --> B) (all A1 : (list A) ((defined-map F A1) => (or (A1 = ()) (some X : A (some Y : (list A) (and (A1 = (cons X Y)) (defined-apply-1 F X) (defined-map F Y))))))))))
(all A : type (all B : type (all P : ((A --> B) => ((list A) => o)) ((and (all F : (A --> B) (P F ())) (all F : (A --> B) (all X : A (all Y : (list A) ((and (defined-apply-1 F X) (P F Y)) => (P F (cons X Y))))))) => (all F : (A --> B) (all A1 : (list A) ((defined-map F A1) => (P F A1))))))))
; definedness: filter
(all A : type (all F : (A --> boolean) (defined-filter F ())))
(all A : type (all F : (A --> boolean) (all X : A (all Y : (list A) ((and (defined-apply-1 F X) (or (and ((F X) = true) (defined-filter F Y)) (and (~ ((F X) = true)) (defined-filter F Y)))) => (defined-filter F (cons X Y)))))))
(all A : type (all F : (A --> boolean) (all A1 : (list A) ((defined-filter F A1) => (or (A1 = ()) (some X : A (some Y : (list A) (and (A1 = (cons X Y)) (defined-apply-1 F X) (or (and ((F X) = true) (defined-filter F Y)) (and (~ ((F X) = true)) (defined-filter F Y)))))))))))
(all A : type (all P : ((A --> boolean) => ((list A) => o)) ((and (all F : (A --> boolean) (P F ())) (all F : (A --> boolean) (all X : A (all Y : (list A) ((and (defined-apply-1 F X) (or (and ((F X) = true) (P F Y)) (and (~ ((F X) = true)) (P F Y)))) => (P F (cons X Y))))))) => (all F : (A --> boolean) (all A1 : (list A) ((defined-filter F A1) => (P F A1)))))))
; definedness: twice
(all A : type (all F : (A --> A) (all X : A ((and (defined-apply-1 F X) (defined-apply-1 F (F X))) => (defined-twice F X)))))
(all A : type (all F : (A --> A) (all X : A ((defined-twice F X) => (and (defined-apply-1 F X) (defined-apply-1 F (F X)))))))
(all A : type (all P : ((A --> A) => (A => o)) ((all F : (A --> A) (all X : A ((and (defined-apply-1 F X) (defined-apply-1 F (F X))) => (P F X)))) => (all F : (A --> A) (all X : A ((defined-twice F X) => (P F X)))))))

; equations
(all X : number ((double X) = (* 2 X)))
(all X : number ((positive? X) = (> X 0)))
(all A : type (all B : type (all F : (A --> B) ((map F ()) = ()))))
(all A : type (all B : type (all F : (A --> B) (all X : A (all Y : (list A) ((and (defined-apply-1 F X) (defined-map F Y)) => ((map F (cons X Y)) = (cons (F X) (map F Y)))))))))
(all A : type (all F : (A --> boolean) ((filter F ()) = ())))
(all A : type (all F : (A --> boolean) (all X : A (all Y : (list A) ((and (defined-apply-1 F X) (or (and ((F X) = true) (defined-filter F Y)) (and (~ ((F X) = true)) (defined-filter F Y)))) => ((filter F (cons X Y)) = (if (F X) (cons X (filter F Y)) (filter F Y))))))))
(all A : type (all F : (A --> A) (all X : A ((and (defined-apply-1 F X) (defined-apply-1 F (F X))) => ((twice F X) = (F (F X)))))))
