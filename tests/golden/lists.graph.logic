; ShenLogic typed evaluation graph v2
(value-signature (constructors (constructor int int 1) (constructor true true 0) (constructor false false 0) (constructor symbol symbol 1) (constructor string string 1) (constructor nil nil 0) (constructor cons cons 2)))
(relation first (value) value)
(relation same-pair? (value) value)
(rule first_c0_p0 (function first) (clause 0) (path 0)
  (args ((v-var first_a0)))
  (bound ((v-var first_a0) (v-var M1) (v-var M0)))
  (when (decompose (v-var first_a0) cons ((v-var M1) (v-var M0))))
  (derive (first (v-var first_a0) (v-var M1)))
)
(rule same-pair?_c0_p0 (function same-pair?) (clause 0) (path 0)
  (args ((v-var same-pair?_a0)))
  (bound ((v-var same-pair?_a0) (v-var M1) (v-var M0)))
  (when (and (decompose (v-var same-pair?_a0) cons ((v-var M1) (v-var M0))) (decompose (v-var M0) cons ((v-var M1) (v-var M0))) (value-eq (v-var M1) (v-var M1)) (decompose (v-var M0) nil ())))
  (derive (same-pair? (v-var same-pair?_a0) v-true))
)
(rule same-pair?_c1_p1 (function same-pair?) (clause 1) (path 1)
  (args ((v-var same-pair?_a0)))
  (bound ((v-var same-pair?_a0)))
  (when (not-tag (v-var same-pair?_a0) cons))
  (derive (same-pair? (v-var same-pair?_a0) v-false))
)
(rule same-pair?_c1_p2 (function same-pair?) (clause 1) (path 2)
  (args ((v-var same-pair?_a0)))
  (bound ((v-var same-pair?_a0) (v-var M1) (v-var M0)))
  (when (and (decompose (v-var same-pair?_a0) cons ((v-var M1) (v-var M0))) (not-tag (v-var M0) cons)))
  (derive (same-pair? (v-var same-pair?_a0) v-false))
)
(rule same-pair?_c1_p3 (function same-pair?) (clause 1) (path 3)
  (args ((v-var same-pair?_a0)))
  (bound ((v-var same-pair?_a0) (v-var M1) (v-var M0)))
  (when (and (decompose (v-var same-pair?_a0) cons ((v-var M1) (v-var M0))) (decompose (v-var M0) cons ((v-var M1) (v-var M0))) (value-neq (v-var M1) (v-var M1))))
  (derive (same-pair? (v-var same-pair?_a0) v-false))
)
(rule same-pair?_c1_p4 (function same-pair?) (clause 1) (path 4)
  (args ((v-var same-pair?_a0)))
  (bound ((v-var same-pair?_a0) (v-var M1) (v-var M0)))
  (when (and (decompose (v-var same-pair?_a0) cons ((v-var M1) (v-var M0))) (decompose (v-var M0) cons ((v-var M1) (v-var M0))) (value-eq (v-var M1) (v-var M1)) (not-tag (v-var M0) nil)))
  (derive (same-pair? (v-var same-pair?_a0) v-false))
)
(least-scc (first))
(least-scc (same-pair?))
(name-map ((first first) (same-pair? same-pair?)))
